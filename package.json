{
  "name": "dsh-session-superagent",
  "version": "0.10.7",
  "workspaces": ["packages/*"],
  "description": "Session-level superagent for DeepSeek Harness: watch a GitHub repository and wake a session when something needs doing. Credentials never reach the model.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./watch": "./lib/watch.js",
    "./redact": "./lib/redact.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./host-primitives": "./ui-host-primitives.js",
    "./orbit-popover": "./ui-orbit-popover.js"
  },
  "files": [
    "lib/index.js",
    "lib/watch.js",
    "lib/gh-format.js",
    "lib/redact.js",
    "lib/body.js",
    "lib/gitee.js",
    "lib/gates.js",
    "lib/state-migration.js",
    "lib/update.js",
    "lib/semver.js",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "SETUP.md",
    "CHANGELOG.md",
    "LICENSE",
    "client.js",
    "ui-host-primitives.js",
    "ui-orbit-popover.js",
    "bin/check.mjs",
    "assets/icon-180.png",
    "assets/icon-app.png",
    "docs/whats-new-0.9.md",
    "docs/json-契约.md",
    "docs/真机验证清单.md",
    "UPDATING.md",
    "CHECKLIST.md",
    "MAINTENANCE.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/test.mjs",
    "preview:orbit": "node scripts/preview-orbit.mjs",
    "sync:profile": "node scripts/sync-profile.mjs",
    "smoke:observe": "node scripts/smoke-observe.mjs",
    "sync:profile:check": "node scripts/sync-profile.mjs --check",
    "sync:profile:repair": "node scripts/sync-profile.mjs --repair",
    "preview": "node scripts/render-preview.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preview:themes": "node scripts/render-preview.mjs preview-themes.html",
    "prepublishOnly": "node scripts/preflight.mjs --fast"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "superagent",
    "watcher",
    "github",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/dsh-session-superagent.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "author": "MYCF711",
  "homepage": "https://github.com/MYCF711/dsh-session-superagent#readme",
  "bugs": {
    "url": "https://github.com/MYCF711/dsh-session-superagent/issues"
  },
  "bin": {
    "dsh-zhuli": "bin/check.mjs"
  },
  "devDependencies": {
    "semver": "7.8.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@mycf711/dsh-gate": "0.1.0"
  }
}
