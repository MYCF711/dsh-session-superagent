{
  "name": "dsh-session-superagent",
  "version": "2.0.0",
  "workspaces": [
    "packages/*"
  ],
  "description": "Session-level superagent for DeepSeek Harness: watch a GitHub repository and wake a session when something needs doing. Credentials never reach the model.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./watch": "./lib/watch.js",
    "./rooms/watermark-state": "./lib/rooms/watermark-state.js",
    "./rooms/watermark-decision": "./lib/rooms/watermark-decision.js",
    "./rooms/data-provider": "./lib/rooms/data-provider.js",
    "./rooms/delivery": "./lib/rooms/delivery.js",
    "./rooms/scheduler": "./lib/rooms/scheduler.js",
    "./rooms/projection": "./lib/rooms/projection.js",
    "./rooms/ticket-state": "./lib/rooms/ticket-state.js",
    "./rooms/thread-subscription": "./lib/rooms/thread-subscription.js",
    "./rooms/execution-assignment": "./lib/rooms/execution-assignment.js",
    "./rooms/executor-host": "./lib/rooms/executor-host.js",
    "./rooms/outbox": "./lib/rooms/outbox.js",
    "./rooms/admission-eval": "./lib/rooms/admission-eval.js",
    "./rooms/source-registry": "./lib/rooms/source-registry.js",
    "./rooms/skill-pack": "./lib/rooms/skill-pack.js",
    "./rooms/ticket-projection": "./lib/rooms/ticket-projection.js",
    "./rooms/draft": "./lib/rooms/draft.js",
    "./rooms/prompt-config": "./lib/rooms/prompt-config.js",
    "./rooms/i18n": "./lib/rooms/i18n.js",
    "./rooms/modular-runtime": "./lib/rooms/modular-runtime.js",
    "./rooms/modular-outbox-host": "./lib/rooms/modular-outbox-host.js",
    "./redact": "./lib/redact.js",
    "./package.json": "./package.json",
    "./client": "./client.js",
    "./host-primitives": "./ui-host-primitives.js",
    "./orbit-popover": "./ui-orbit-popover.js"
  },
  "files": [
    "lib/index.js",
    "lib/watch.js",
    "lib/rooms/watermark-state.js",
    "lib/rooms/watermark-decision.js",
    "lib/rooms/data-provider.js",
    "lib/rooms/delivery.js",
    "lib/rooms/scheduler.js",
    "lib/rooms/projection.js",
    "lib/rooms/ticket-state.js",
    "lib/rooms/thread-subscription.js",
    "lib/rooms/execution-assignment.js",
    "lib/rooms/executor-host.js",
    "lib/rooms/outbox.js",
    "lib/rooms/admission-eval.js",
    "lib/rooms/source-registry.js",
    "lib/rooms/skill-pack.js",
    "lib/rooms/ticket-projection.js",
    "lib/rooms/draft.js",
    "lib/rooms/prompt-config.js",
    "lib/rooms/i18n.js",
    "lib/rooms/modular-runtime.js",
    "lib/rooms/modular-outbox-host.js",
    "lib/gh-format.js",
    "lib/pr-watch.js",
    "lib/redact.js",
    "lib/body.js",
    "lib/gitee.js",
    "lib/gates.js",
    "lib/state-migration.js",
    "lib/update.js",
    "lib/semver.js",
    "cordis.patch.yml",
    "README.md",
    "AGENTS.md",
    "SETUP.md",
    "CHANGELOG.md",
    "LICENSE",
    "client.js",
    "ui-host-primitives.js",
    "ui-orbit-popover.js",
    "bin/check.mjs",
    "assets/icon-180.png",
    "assets/icon-app.png",
    "skills/dsh-session-superagent-github/SKILL.md",
    "docs/设计-模块化房间.md",
    "docs/whats-new-0.9.md",
    "docs/json-契约.md",
    "docs/真机验证清单.md",
    "UPDATING.md",
    "CHECKLIST.md",
    "MAINTENANCE.md"
  ],
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "check": "node scripts/test.mjs",
    "preview:orbit": "node scripts/preview-orbit.mjs",
    "sync:profile": "node scripts/sync-profile.mjs",
    "smoke:observe": "node scripts/smoke-observe.mjs",
    "sync:profile:check": "node scripts/sync-profile.mjs --check",
    "sync:profile:repair": "node scripts/sync-profile.mjs --repair",
    "preview": "node scripts/render-preview.mjs",
    "preflight": "node scripts/preflight.mjs",
    "preview:themes": "node scripts/render-preview.mjs preview-themes.html",
    "prepublishOnly": "node scripts/preflight.mjs --fast"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "superagent",
    "watcher",
    "github",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/dsh-session-superagent.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "author": "MYCF711",
  "homepage": "https://github.com/MYCF711/dsh-session-superagent#readme",
  "bugs": {
    "url": "https://github.com/MYCF711/dsh-session-superagent/issues"
  },
  "bin": {
    "dsh-zhuli": "bin/check.mjs"
  },
  "devDependencies": {
    "semver": "7.8.6"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@mycf711/dsh-gate": "0.1.5"
  }
}
